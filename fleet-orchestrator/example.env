# Copy to .env (same folder) and fill in. .env is git-ignored; never commit a real key.
#   cp example.env .env

# Claude credentials (https://console.anthropic.com).
# Leave empty to run the greedy coordinator only.
ANTHROPIC_API_KEY=

# Which coordinator plans for the fleet: greedy (offline, default) or llm (Claude decides).
COORDINATOR=greedy

# Claude coordinator settings (optional).
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# Seconds per API request
LLM_TIMEOUT=45
# Seconds per replan before falling back to the greedy plan
LLM_BUDGET=90
# Tool-loop turns per replan
LLM_MAX_TURNS=8

# Maintenance agent: ticks (minutes) until a broken tractor / blocked road fixes itself
REPAIR_TRACTOR_MIN=5
REPAIR_ROAD_MIN=10
